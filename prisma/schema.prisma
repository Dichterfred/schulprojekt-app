generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  TEACHER
}

/// Lehrer und Superuser (Schüler sind eigene Tabelle `Student`).
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  ownedProjects Project[]
}

model SchoolClass {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @unique

  students Student[]
  projects Project[] @relation("ProjectSchoolClasses")
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  schoolClassId String
  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)

  enrollments Enrollment[]
  assignments Assignment[]

  @@index([schoolClassId])
}

model Project {
  id                 String   @id @default(cuid())
  name               String
  description        String
  studentCount       Int
  /// Wird beim Anlegen aus dem Namen erzeugt und danach nicht mehr verändert.
  code               String   @unique
  startDate          DateTime
  endDate            DateTime
  enrollmentDeadline DateTime
  createdAt          DateTime @default(now())

  imageId String? @unique
  image   Image?  @relation("ProjectImage", fields: [imageId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  schoolClasses SchoolClass[] @relation("ProjectSchoolClasses")
  groups        Group[]
  enrollments   Enrollment[]
  assignments   Assignment[]

  @@index([ownerId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String
  maxStudents Int
  createdAt   DateTime @default(now())

  imageId String? @unique
  image   Image?  @relation("GroupImage", fields: [imageId], references: [id], onDelete: SetNull)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  preferences Preference[]
  assignments Assignment[]

  @@index([projectId])
}

/// Einschreibung eines Schülers in ein Projekt. Trägt die Login-PIN (als Hash).
model Enrollment {
  id        String   @id @default(cuid())
  pinHash   String
  createdAt DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  preferences Preference[]

  @@unique([projectId, studentId])
  @@index([studentId])
}

/// Priorität eines eingeschriebenen Schülers für eine Gruppe (Eingabe für den Einteilungsalgorithmus).
model Preference {
  id        String   @id @default(cuid())
  rank      Int
  updatedAt DateTime @updatedAt

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, groupId])
  @@unique([enrollmentId, rank])
  @@index([groupId])
}

/// Ergebnis der Einteilung: ein Schüler landet pro Projekt in genau einer Gruppe.
model Assignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([groupId])
}

/// Bannerbilder, getrennt von Projekt/Gruppe gespeichert, damit Listen keine Bilddaten laden.
model Image {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  project Project? @relation("ProjectImage")
  group   Group?   @relation("GroupImage")
}
