generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  TEACHER
  STUDENT
}

model User {
  id           String  @id @default(cuid())
  username     String? @unique
  passwordHash String?
  role         Role

  firstName String?
  lastName  String?

  createdAt DateTime @default(now())

  ownedProjects Project[] @relation("OwnedProjects")

  enrolledProjectId String?
  enrolledProject    Project? @relation("Enrollment", fields: [enrolledProjectId], references: [id], onDelete: Cascade)

  groupPriorities GroupPriority[]
}

model SchoolClass {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @unique
  projects  Project[] @relation("ProjectSchoolClasses")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String
  studentCount Int
  code         String   @unique

  // Optional: Pfad zum Banner-Bild (z.B. "/uploads/projects/abc123.jpg")
  bannerImage  String?

  startDate          DateTime
  endDate            DateTime
  enrollmentDeadline DateTime

  ownerId String?
  owner   User?   @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: SetNull)

  schoolClasses SchoolClass[] @relation("ProjectSchoolClasses")

  groups          Group[]
  students        User[]          @relation("Enrollment")
  groupPriorities GroupPriority[]

  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String
  maxStudents Int

  // Optional: Pfad zum Banner-Bild (z.B. "/uploads/groups/abc123.jpg")
  bannerImage String?

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  groupPriorities GroupPriority[]
}

model GroupPriority {
  id        String @id @default(cuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  priority Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId])
  @@unique([studentId, priority])
}
